meta {
  name: List Runs
  type: http
  seq: 8
}

get {
  url: {{base_url}}/runs
  body: none
  auth: none
}

params:query {
  ~status: done
  ~preset: es_schwefel
  ~cursor: {{next_cursor}}
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.getStatus() === 200) {
    const cursor = res.getBody().next_cursor;
    bru.setVar("next_cursor", cursor || "");
    if (!cursor) {
      console.log("Last page reached. Uncheck cursor to start again.");
    }
  }
}
